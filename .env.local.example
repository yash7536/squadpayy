# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in the browser (it's the "public" key) —
# it is NOT a secret, access is controlled by Row Level Security rules.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key (Settings -> API -> service_role). Do NOT prefix this with
# NEXT_PUBLIC_ — that would ship it to the browser. It's only used in
# server-side code (e.g. the public payment-link route) to look up a record
# by its token. Keep it out of any client component.
SUPABASE_SERVICE_ROLE_KEY=
